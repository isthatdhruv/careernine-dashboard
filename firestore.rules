rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read from settings collection
    match /settings/{document=**} {
      allow read: if true;
      allow write: if false; // Only allow writes via admin or server
    }
    
    // Keep existing rules for users collection
    match /users/{userId} {
      allow read: if true;  // Allow anyone to read the users collection (not recommended for production)
      allow write: if request.auth != null;  // Only authenticated users can write
    }
    
    // Add rules for coupons if needed
    match /coupons/{document} {
      allow read: if true;
      allow write: if false; // Only allow writes via admin or server
    }
  }
}